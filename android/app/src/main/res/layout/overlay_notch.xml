<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notchRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/notchGlow"
        android:layout_width="320dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="-12dp"
        android:alpha="0.7"
        android:background="@drawable/notch_siri_glow" />

    <LinearLayout
        android:id="@+id/notchPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/notch_liquid_glass"
        android:elevation="32dp"
        android:minWidth="126dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/notchCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:orientation="horizontal">

            <com.kaivor.agent.SiriWaveformView
                android:id="@+id/siriWaveform"
                android:layout_width="52dp"
                android:layout_height="22dp" />

            <LinearLayout
                android:id="@+id/notchTextBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNotchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="KAIVOR"
                    android:textColor="@color/apple_label_tertiary"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvNotchTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/apple_label_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notchControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnNotchPause"
                    android:layout_width="@dimen/notch_control_size"
                    android:layout_height="@dimen/notch_control_size"
                    android:background="@drawable/notch_btn_pause_bg"
                    android:clickable="true"
                    android:contentDescription="Pause or resume task"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notch_pause" />

                <ImageButton
                    android:id="@+id/btnNotchStop"
                    android:layout_width="@dimen/notch_control_size"
                    android:layout_height="@dimen/notch_control_size"
                    android:layout_marginStart="@dimen/notch_control_gap"
                    android:background="@drawable/notch_btn_stop_bg"
                    android:clickable="true"
                    android:contentDescription="Stop task"
                    android:focusable="true"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notch_stop" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActivityCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/chip_notch_count"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="22dp"
                android:minHeight="22dp"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textColor="@color/apple_label_primary"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notchExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minWidth="280dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:background="#28FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="ACTIVE NOW"
                android:textColor="@color/apple_label_tertiary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvNotchStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/apple_label_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvNotchSkill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/apple_label_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNotchStackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="BACKGROUND"
                android:textColor="@color/apple_label_tertiary"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/notchActivityList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>