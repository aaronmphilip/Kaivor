<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notchRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/notchGlow"
        android:layout_width="320dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="-12dp"
        android:alpha="0.7"
        android:background="@drawable/notch_siri_glow" />

    <LinearLayout
        android:id="@+id/notchPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/notch_liquid_glass"
        android:elevation="32dp"
        android:minWidth="126dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp">

        <!-- Collapsed Siri bar -->
        <LinearLayout
            android:id="@+id/notchCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:orientation="horizontal">

            <com.kaivor.agent.SiriWaveformView
                android:id="@+id/siriWaveform"
                android:layout_width="52dp"
                android:layout_height="22dp" />

            <LinearLayout
                android:id="@+id/notchTextBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNotchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:text="KAIVOR"
                    android:textColor="#66FFFFFF"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvNotchTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notchControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnNotchPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/notch_btn_bg"
                    android:clickable="true"
                    android:contentDescription="Pause task"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notch_pause" />

                <ImageButton
                    android:id="@+id/btnNotchStop"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/notch_btn_bg"
                    android:clickable="true"
                    android:contentDescription="Stop task"
                    android:focusable="true"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notch_stop" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActivityCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/chip_apple"
                android:fontFamily="sans-serif-medium"
                android:minWidth="20dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Expanded activity stack (Dynamic Island / Clicky) -->
        <LinearLayout
            android:id="@+id/notchExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="280dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="#28FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Active now"
                android:textColor="#636366"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvNotchStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvNotchSkill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#98989D"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvNotchStackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Background"
                android:textColor="#636366"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/notchActivityList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>