<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notchRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/notchGlow"
        android:layout_width="280dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="-8dp"
        android:alpha="0.65"
        android:background="@drawable/notch_glow" />

    <LinearLayout
        android:id="@+id/notchPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/notch_pill_bg"
        android:elevation="28dp"
        android:minWidth="260dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- Collapsed row (always visible) -->
        <LinearLayout
            android:id="@+id/notchCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/notchDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/notch_dot_active" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNotchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="KAIVOR"
                    android:textColor="#80FFFFFF"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvNotchTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNotchPause"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/notch_btn_bg"
                android:contentDescription="Pause task"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_notch_pause" />

            <ImageButton
                android:id="@+id/btnNotchStop"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/notch_btn_bg"
                android:contentDescription="Stop task"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_notch_stop" />

            <ImageButton
                android:id="@+id/btnNotchExpand"
                android:layout_width="28dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="Show task details"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_notch_chevron" />
        </LinearLayout>

        <!-- Expanded panel (Dynamic Island style) -->
        <LinearLayout
            android:id="@+id/notchExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:background="#22FFFFFF" />

            <TextView
                android:id="@+id/tvNotchStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvNotchSkill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#98989D"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvNotchQueueTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Up next"
                android:textColor="#636366"
                android:textSize="10sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/notchQueueList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>